# ==============================================
# Microservices Platform Environment Variables Example
# Copy this file to .env: cp .env.example .env
# ==============================================

# API Gateway Configuration
GATEWAY_PORT=5000
JWT_SECRET=ecommerce-microservices-secret-key-2026

# Microservice Port Allocations
AUTH_SERVICE_PORT=5008
USER_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
PURCHASE_SERVICE_PORT=5003
ORDER_SERVICE_PORT=5004
SALE_SERVICE_PORT=5005
INVENTORY_SERVICE_PORT=5006
NOTIFICATION_SERVICE_PORT=5007
POLICY_SERVICE_PORT=5009

# Downstream Microservice URLs for Gateway Proxy
AUTH_SERVICE_URL=http://localhost:5008
USER_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_URL=http://localhost:5002
PURCHASE_SERVICE_URL=http://localhost:5003
ORDER_SERVICE_URL=http://localhost:5004
SALE_SERVICE_URL=http://localhost:5005
INVENTORY_SERVICE_URL=http://localhost:5006
NOTIFICATION_SERVICE_URL=http://localhost:5007
POLICY_SERVICE_URL=http://localhost:5009

# Database Connection Pooling & Timeouts
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
DB_POOL_MAX_USES=7500

# PostgreSQL Database Connections (Port 5433)
AUTH_DB_URL=postgresql://postgres:postgres@localhost:5433/auth_db
USER_DB_URL=postgresql://postgres:postgres@localhost:5433/user_db
PRODUCT_DB_URL=postgresql://postgres:postgres@localhost:5433/product_db
PURCHASE_DB_URL=postgresql://postgres:postgres@localhost:5433/purchase_db
ORDER_DB_URL=postgresql://postgres:postgres@localhost:5433/order_db
SALE_DB_URL=postgresql://postgres:postgres@localhost:5433/sale_db
INVENTORY_DB_URL=postgresql://postgres:postgres@localhost:5433/inventory_db
NOTIFICATION_DB_URL=postgresql://postgres:postgres@localhost:5433/notification_db
POLICY_DB_URL=postgresql://postgres:postgres@localhost:5433/policy_db

# Admin Seed Credentials (required — never commit real values)
# Used by the auth/user seeds and the services' first-start auto-seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=System Administrator

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ecommerce-products
MINIO_PUBLIC_URL=http://localhost:9000
