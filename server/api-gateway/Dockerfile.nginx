FROM nginx:alpine

# Remove default Nginx site configuration
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy custom Nginx API Gateway (engine-x) configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose API Gateway ports (5000 for app client, 80 standard HTTP)
EXPOSE 5000 80

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
