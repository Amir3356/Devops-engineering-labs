    {
      "type": "table",
      "id": 12,
      "title": "Recent traces \u2014 $service",
      "description": "Click a Trace ID to open the waterfall; from a span, jump to its logs",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && kind = server}",
          "limit": 20,
          "tableType": "traces",
          "spss": 3
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "id": 13,
      "title": "Slow traces (> 500 ms)",
