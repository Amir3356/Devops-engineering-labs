    {
      "type": "timeseries",
      "id": 18,
      "title": "Inter-service latency p95 (server side)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket[5m])))",
          "range": true,
          "instant": false,
          "legendFormat": "{{client}} \u2192 {{server}}"
