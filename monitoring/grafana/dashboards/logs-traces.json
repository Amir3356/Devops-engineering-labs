      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service:regex}\" && traceDuration > 500ms}",
          "limit": 20,
          "tableType": "traces",
          "spss": 3
        }
      ],
      "fieldConfig": {
        "defaults": {},
