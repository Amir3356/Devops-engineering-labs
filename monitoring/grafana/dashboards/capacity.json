        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * max(active_users{service=\"api-gateway\",window=\"1m\"}) / scalar((last_over_time(k6_capacity_users[7d]) and on(testid) topk(1, last_over_time(k6_capacity_result_time[7d]))))",
