      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time(((sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s])) and on() (((min_over_time(max(k6_vus{testid=~\"$testid\"})[30s:5s]) == on() max_over_time(max(k6_vus{testid=~\"$testid\"})[30s:5s])) > 0) < scalar((min_over_time((((min_over_time(max(k6_vus{testid=~\"$testid\"})[30s:5s]) == on() max_over_time(max(k6_vus{testid=~\"$testid\"})[30s:5s])) > 0) and on() (((histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\"}[30s])))) > $slo_latency_ms / 1000) or on() ((100 * (sum(rate(k6_http_reqs_total{testid=~\"$testid\",expected_response=\"false\"}[30s])) or vector(0)) / sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))) > $slo_error_pct)))[$__range:5s] @ end()) or vector(1e12))))) and on() ((histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\"}[30s])))) <= $slo_latency_ms / 1000) and on() ((100 * (sum(rate(k6_http_reqs_total{testid=~\"$testid\",expected_response=\"false\"}[30s])) or vector(0)) / sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))) <= $slo_error_pct))[$__range:5s] @ end())",
          "range": false,
          "instant": true
