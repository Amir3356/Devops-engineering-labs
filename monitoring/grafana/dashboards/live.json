{
  "uid": "nexuscommerce-live",
  "title": "NexusCommerce \u2014 Live",
  "description": "Real-time (1 s) API metrics streamed over Grafana Live (WebSocket) \u2014 no polling",
  "tags": [
    "nexuscommerce",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "liveNow": true,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "links": [
    {
      "title": "System Overview",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/nexuscommerce-overview/nexuscommerce-system-overview"
    },
    {
      "title": "Logs & Traces",
      "type": "link",
      "icon": "doc",
      "url": "/d/nexuscommerce-logs-traces/nexuscommerce-logs-and-traces"
